{
  "color": {
    "bg":       { "base": "#0A0A0A", "deep": "#121212", "pure": "#000000" },
    "surface":  { "card": "#1C1C1E", "mid": "#2C2C2E", "high": "#3A3A3C", "glass": "#F5F5F7" },
    "brand":    { "primary": "#007AFF", "mint": "#00C7BE", "cyan": "#00E5FF", "violet": "#8A2BE2" },
    "premium":  { "gold": "#D4AF37", "founder": "#FFD700" },
    "text":     { "primary": "#FFFFFF", "secondary": "#8E8E93", "tertiary": "#636366", "quaternary": "#494949", "inverse": "#121212" },
    "status":   { "success": "#34C759", "warning": "#FF9500", "error": "#FF3B30", "live": "#FF0000", "terminal": "#39FF14", "darkGreen": "#001A00" }
  },
  "gradient": {
    "brand":      { "from": "#007AFF", "to": "#00C7BE", "angle": "135deg" },
    "neon":       { "from": "#00E5FF", "to": "#8A2BE2", "angle": "135deg" },
    "elite":      { "from": "#D4AF37", "to": "#00C7BE", "angle": "135deg" },
    "mesh":       { "from": "rgba(0,122,255,0.10)", "to": "rgba(0,199,190,0.10)", "angle": "135deg" },
    "onboarding": { "stops": ["#0D47A1", "#1A237E", "#4A148C"], "angle": "135deg" }
  },
  "radius": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 24, "pill": 999, "input": 15 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 24, "3xl": 32, "4xl": 40 },
  "blur": { "glass": 4, "softLock": 5 },
  "shadow": {
    "glass": "0 10px 20px -5px rgba(0,0,0,0.10)",
    "card":  "0 4px 12px rgba(0,0,0,0.20)"
  },
  "glass": {
    "fillOpacity": 0.08,
    "borderOpacity": 0.12,
    "borderColor": "#F5F5F7"
  },
  "font": {
    "family": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono":   "'JetBrains Mono', 'Fira Code', monospace",
    "scale": {
      "display": { "size": 28, "weight": 700, "tracking": "0" },
      "h1":      { "size": 24, "weight": 700, "tracking": "-0.3px" },
      "h2":      { "size": 20, "weight": 700, "tracking": "-0.2px" },
      "h3":      { "size": 18, "weight": 600, "tracking": "0" },
      "title":   { "size": 16, "weight": 600, "tracking": "0" },
      "body":    { "size": 14, "weight": 400, "tracking": "0", "lineHeight": 1.4 },
      "bodySm":  { "size": 13, "weight": 400, "tracking": "0", "lineHeight": 1.4 },
      "caption": { "size": 12, "weight": 500, "tracking": "0.3px" },
      "micro":   { "size": 11, "weight": 600, "tracking": "0.4px" },
      "nano":    { "size": 9,  "weight": 700, "tracking": "1px" }
    }
  },
  "breakpoint": { "watch": 200, "mobile": 600, "tablet": 1024, "desktop": 1920 },
  "motion": {
    "fast": "150ms",
    "base": "300ms",
    "slow": "600ms",
    "pulse": "1500ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  }
}
