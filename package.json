{
  "name": "smartspectra-electron-quickstart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform Electron quickstart for @smartspectra/node-sdk.",
  "main": "main.cjs",
  "scripts": {
    "build": "esbuild renderer.js --bundle --outfile=dist/renderer.bundle.js --platform=browser --format=iife --log-level=warning",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "server": "node server.js",
    "server:dev": "node server/index.js",
    "dev": "vite"
  },
  "dependencies": {
    "@oheoco/logged": "^0.1.18",
    "@smartspectra/node-sdk": "latest",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.0",
    "cors": "^2.8.6",
    "electron": "^45.2.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron-builder": "^26.6.0",
    "esbuild": "^0.25.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "fast-uri": "3.1.6",
    "@xmldom/xmldom": "0.8.15"
  },
  "build": {
    "appId": "com.presagetech.smartspectra-electron-quickstart",
    "productName": "SmartSpectra Quickstart",
    "files": [
      "main.cjs",
      "index.html",
      "styles.css",
      "dist/**",
      "node_modules/**",
      "!node_modules/@smartspectra/node-sdk-*/**",
      "!node_modules/@smartspectra/node-sdk/scripts/**",
      "!node_modules/@smartspectra/node-sdk/test/**",
      "!node_modules/@smartspectra/node-sdk/samples/**",
      "!node_modules/@smartspectra/node-sdk/prebuilds/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "SmartSpectra needs camera access for video-based vitals measurement."
      },
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-darwin-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-linux-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "asar": true
  }
}
